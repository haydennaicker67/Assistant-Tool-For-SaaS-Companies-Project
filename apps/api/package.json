    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "openai": "^7.45.1",
    "paystack-sdk-node": "^0.8.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "postgres": "^3.4.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vizzly-sa/config": "workspace:*",
    "drizzle-kit": "^0.31.11",
